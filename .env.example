# Copy to .env.local for local development, and add the same names in Vercel -> Settings -> Environment Variables.
# Leave Supabase values empty to run in preview mode with sample data.

# Browser (public)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_VAPID_PUBLIC_KEY=

# Server only — never expose these in VITE_ variables
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
BACHS_SECRET_KEY=
BACHS_WEBHOOK_SECRET=
CRON_SECRET=
RESEND_API_KEY=
TYCHE_EMAIL_FROM=Tyche <notifications@gettyche.com.ng>
TYCHE_EMAIL_REPLY_TO=support@gettyche.com.ng
GOOGLE_SCRIPT_URL=
GOOGLE_SCRIPT_SECRET=
COMMUNITY_INVITE_URL=
COMMUNITY_PRICE=5000
SITE_URL=https://gettyche.com.ng

# Push notifications (generate in /admin -> Notifications)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@gettyche.com.ng
