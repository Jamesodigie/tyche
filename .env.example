# Copy to .env.local for local development, and add the same names in Vercel → Settings → Environment Variables.
# Leave the Supabase values empty to run in preview mode with sample data.

# Browser (public)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_VAPID_PUBLIC_KEY=

# Server only — never expose these
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
BACHS_SECRET_KEY=
BACHS_WEBHOOK_SECRET=
CRON_SECRET=
GOOGLE_SCRIPT_URL=
GOOGLE_SCRIPT_SECRET=
COMMUNITY_INVITE_URL=
COMMUNITY_PRICE=5000
SITE_URL=
# Push notifications (generate in /admin → Notifications)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@tyche.io
